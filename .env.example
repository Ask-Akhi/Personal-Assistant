# ── Core ─────────────────────────────────────────────────────────────
APP_ENV=dev
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata

# ── Database ─────────────────────────────────────────────────────────
# Local dev: sqlite. Prod (Render): postgresql+asyncpg://...
DATABASE_URL=sqlite+aiosqlite:///./data/assistant.db

# ── Telegram (control surface) ───────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
ADMIN_PIN=
PIN_SESSION_MINUTES=15

# ── Quiet hours (no auto-sends) ──────────────────────────────────────
QUIET_HOURS_START=22
QUIET_HOURS_END=8
UNDO_WINDOW_SECONDS=30

# ── LLM provider (draft generation) ─────────────────────────────────
# Chain: primary -> groq -> anthropic on failure
# "gemini"    free 1,500 req/day  - get key: https://aistudio.google.com
# "groq"      free 14,400 req/day - get key: https://console.groq.com
# "anthropic" paid ~$0.002/call   - best Hindi/Hinglish quality
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# ── Cost caps (USD / month, per provider) ────────────────────────────
COST_CAP_ANTHROPIC=20
COST_CAP_OPENAI=10
COST_CAP_ELEVENLABS=10
COST_CAP_GEMINI=0
COST_CAP_GROQ=0

# ── WhatsApp Cloud API ───────────────────────────────────────────────
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ── Reserved for later phases ────────────────────────────────────────
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
TELEGRAM_MIRROR_ENABLED=true
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
